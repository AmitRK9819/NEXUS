# ============================================================
# NEXUS DPI & Governance Platform — Environment Configuration
# ============================================================

# Database Credentials
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexusdb
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexusdb
SYNC_DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexusdb

# DPDP Consent Hashing
CONSENT_HASH_SALT=nexus-secret-salt-2026
CONSENT_TTL_DAYS=180

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GEMINI_AVAILABLE=true

# Optional: Google Gemini API Key for dynamic proposal briefs
GEMINI_API_KEY=
