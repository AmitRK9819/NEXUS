# ============================================================
# NEXUS Platform — Environment Configuration
# Copy this file to .env and update values for your local setup
# ============================================================

# ── PostgreSQL / PostGIS ──────────────────────────────────────
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexusdb

# Sync connection (used by seed_data.py and root app/)
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexusdb

# ── Google Gemini AI (Optional) ───────────────────────────────
# If set, the Policy Intelligence Platform uses Gemini 2.0 Flash
# for AI-powered proposal generation. If empty, falls back to
# mock proposal generation.
GEMINI_API_KEY=

# ── Service Integration ──────────────────────────────────────
# Listener Layer → Data Fusion Backend handoff endpoint
MEMBER_2_ENDPOINT=http://backend:8000/api/v1/requests/ingest

# ── Frontend API URL ──────────────────────────────────────────
# Set to the Data Fusion Backend base URL for frontend apps
NEXT_PUBLIC_API_URL=http://localhost:8000
