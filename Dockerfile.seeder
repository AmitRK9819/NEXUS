# NEXUS Platform — Seeder Dockerfile
# Runs seed_data.py to populate PostGIS with mock data
# Usage: docker-compose --profile seed run seeder

FROM python:3.11-slim

WORKDIR /nexus

# System deps for PostGIS client libs
RUN apt-get update && apt-get install -y \
    libpq-dev build-essential libgeos-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY seed_data.py .

CMD ["python", "seed_data.py"]
